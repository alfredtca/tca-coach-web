# ─── REQUIRED for live AI agents ──────────────────────────────────────
# Without this, /api/chat/[slug] falls back to deterministic offline
# replies — the UI still works, but the specialists don't speak.
# Get a key at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=

# ─── Recommended ──────────────────────────────────────────────────────
# Used by sitemap, robots.txt, and og: metadata. Leave the default if
# you don't have a custom domain yet — Vercel will use its preview URL.
NEXT_PUBLIC_SITE_URL=https://coach.thecommercialathlete.com.au

# ─── Future integrations — placeholders only ──────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_PUBLIC_KEY=
RESEND_API_KEY=
